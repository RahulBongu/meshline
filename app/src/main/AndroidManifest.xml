<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Meshline NEVER declares INTERNET. The no-network promise is verifiable:
      `aapt dump permissions app-debug.apk` must never list
      android.permission.INTERNET. We must also audit the *merged* manifest
      (app/build/intermediates/merged_manifests) because a dependency could
      sneak it in. None of the current dependencies (Compose, Room, BC,
      SQLCipher) add INTERNET, but this is checked again in Phase E.
    -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Camera is requested only when the user taps Scan (D1). ZXing is offline; see aapt audit. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Bluetooth: legacy permissions only before Android 12 (API 31). -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- BLE scan on Android <= 11 requires location; from Android 12 the
         BLUETOOTH_SCAN permission with neverForLocation replaces it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="31" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="31" />

    <!-- Android 12+ (API 31+) runtime Bluetooth permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Foreground service for background relay (Phase E) and its
         Android 13+ notification. TargetSdk 36 requires the
         connected-device FGS type to be declared both here and at
         Service.startForeground(). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meshline">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Meshline">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.BleMeshService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
